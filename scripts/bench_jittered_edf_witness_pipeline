#!/bin/sh
set -eu

out=${1:-}
if [ -z "$out" ]; then
  out=$(mktemp)
  echo "writing benchmark CSV to $out" >&2
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

printf 'case,engine,thread_mode,task_count,schema_version,cutoff,basis_window_count,witness_bytes,wall_ms,peak_kb,status\n' > "$out"

cat > "$tmp/small.csv" <<'CSV'
cost,period,deadline,offset,jitter
1,2,2,0,0
CSV

cat > "$tmp/medium.csv" <<'CSV'
cost,period,deadline,offset,jitter
1,2,2,0,0
1,3,3,0,1
CSV

cat > "$tmp/large.csv" <<'CSV'
cost,period,deadline,offset,jitter
1,8,8,0,1
CSV

cat > "$tmp/limit_near.csv" <<'CSV'
cost,period,deadline,offset,jitter
1,16,16,0,1
CSV

now_ms() {
  date +%s%3N
}

run_rust() {
  name=$1
  threads=$2
  witness="$tmp/$name.$threads.cbor"
  metrics="$tmp/$name.$threads.metrics.csv"
  err="$tmp/$name.$threads.err"
  start=$(now_ms)
  status=ok
  if ! ./target/debug/sched-witness-gen jittered-periodic-edf --tasks "$tmp/$name.csv" --out "$witness" --threads "$threads" --metrics-out "$metrics" > /dev/null 2> "$err"; then
    status=failed
  fi
  end=$(now_ms)
  wall_ms=$((end - start))
  if [ "$status" = ok ] && [ -f "$metrics" ]; then
    row=$(sed -n '2p' "$metrics")
    IFS=, read -r task_count schema_ver cutoff basis_window_count requested_threads _status <<EOF
$row
EOF
    if [ "$schema_ver" != 3 ]; then
      printf '%s,rust-generator,%s,%s,%s,%s,%s,unavailable,%s,unavailable,failed\n' \
        "$name" "$requested_threads" "$task_count" "$schema_ver" "$cutoff" \
        "$basis_window_count" "$wall_ms" >> "$out"
      echo "expected jittered witness schema 3; got $schema_ver" >&2
      return 1
    fi
    witness_bytes=$(wc -c < "$witness" | tr -d ' ')
    printf '%s,rust-generator,%s,%s,%s,%s,%s,%s,%s,unavailable,%s\n' \
      "$name" "$requested_threads" "$task_count" "$schema_ver" "$cutoff" \
      "$basis_window_count" "$witness_bytes" "$wall_ms" "$status" >> "$out"
    if [ "$threads" = auto ]; then
      run_haskell_witness_check "$name" "$witness" "$task_count" "$schema_ver" "$cutoff" \
        "$basis_window_count" "$witness_bytes"
    fi
  else
    printf '%s,rust-generator,%s,unavailable,%s,unavailable,unavailable,unavailable,%s,unavailable,%s\n' \
      "$name" "$threads" 3 "$wall_ms" "$status" >> "$out"
  fi
}

run_haskell_witness_check() {
  name=$1
  witness=$2
  task_count=$3
  schema_ver=$4
  cutoff=$5
  basis_window_count=$6
  witness_bytes=$7
  err="$tmp/$name.schema$schema_ver.check.err"
  start=$(now_ms)
  status=ok
  if ! ./scripts/jittered_edf_witness_check --tasks "$tmp/$name.csv" --witness "$witness" > /dev/null 2> "$err"; then
    status=failed
  fi
  end=$(now_ms)
  wall_ms=$((end - start))
  printf '%s,haskell-witness-check,auto,%s,%s,%s,%s,%s,%s,unavailable,%s\n' \
    "$name" "$task_count" "$schema_ver" "$cutoff" \
    "$basis_window_count" "$witness_bytes" "$wall_ms" "$status" >> "$out"
}

for name in small medium large limit_near; do
  run_rust "$name" 1
  run_rust "$name" 2
  run_rust "$name" auto
done

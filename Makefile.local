extract-handoff-accept-hs::
	mkdir -p extracted/haskell
	$(MAKE) theories/Operational/Awkernel/HandoffAcceptanceExtraction.vo

extract-workload-accept-hs::
	mkdir -p extracted/haskell
	$(MAKE) theories/Operational/Awkernel/Minimal/WorkloadAcceptanceExtraction.vo

extract-periodic-edf-sched-hs::
	mkdir -p extracted/haskell
	$(MAKE) theories/TaskModels/Periodic/PeriodicEDFExtraction.vo

scripts/periodic_edf_schedulability_csv: scripts/periodic_edf_schedulability_csv.hs extracted/haskell/PeriodicEDFSchedulability.hs
	ghc -O2 -iextracted/haskell -outputdir scripts/.build -o $@ $<

build-periodic-edf-sched-csv:: extract-periodic-edf-sched-hs scripts/periodic_edf_schedulability_csv

run-periodic-edf-sched-csv:: build-periodic-edf-sched-csv
	@test -n "$(CSV)" || (echo "usage: make run-periodic-edf-sched-csv CSV=tasks.csv" && exit 2)
	./scripts/periodic_edf_schedulability_csv "$(CSV)"

sched-witness-gen::
	cargo build -p sched-witness-gen

post-all:: sched-witness-gen

test-sched-witness-gen-determinism:: sched-witness-gen
	@tmp=$$(mktemp -d); \
	trap 'rm -rf "$$tmp"' EXIT; \
	printf 'cost,period,deadline\n1,4,4\n1,5,5\n' > "$$tmp/zero.csv"; \
	printf 'cost,period,deadline,offset\n1,4,4,1\n1,5,5,2\n' > "$$tmp/offset.csv"; \
	for csv in zero offset; do \
		./target/debug/sched-witness-gen periodic-edf --tasks "$$tmp/$$csv.csv" --out "$$tmp/$$csv.threads1.json" --threads 1; \
		./target/debug/sched-witness-gen periodic-edf --tasks "$$tmp/$$csv.csv" --out "$$tmp/$$csv.threads2.json" --threads 2; \
		./target/debug/sched-witness-gen periodic-edf --tasks "$$tmp/$$csv.csv" --out "$$tmp/$$csv.auto.json" --threads auto; \
		cmp "$$tmp/$$csv.threads1.json" "$$tmp/$$csv.threads2.json"; \
		cmp "$$tmp/$$csv.threads1.json" "$$tmp/$$csv.auto.json"; \
	done; \
	if ./target/debug/sched-witness-gen periodic-edf --tasks "$$tmp/zero.csv" --out "$$tmp/bad.json" --threads 0 > "$$tmp/bad.out" 2>&1; then \
		cat "$$tmp/bad.out"; \
		exit 1; \
	fi; \
	grep -q -- '--threads must be positive or auto' "$$tmp/bad.out"

test-periodic-edf-sched-csv:: build-periodic-edf-sched-csv
	@tmp=$$(mktemp -d); \
	trap 'rm -rf "$$tmp"' EXIT; \
	printf 'cost,period,deadline\n1,4,4\n1,5,5\n' > "$$tmp/zero.csv"; \
	printf 'cost,period,deadline,offset\n1,4,4,1\n1,5,5,2\n' > "$$tmp/nonzero.csv"; \
	printf 'cost,period,deadline,offset\n2,3,3,0\n2,3,3,1\n' > "$$tmp/overload.csv"; \
	printf 'cost,period,deadline,offset\n1,4,4,-1\n' > "$$tmp/negative-offset.csv"; \
	printf 'cost,period,deadline,offset\n2,5,2,0\n2,5,2,2\n' > "$$tmp/offset-value.csv"; \
	printf 'cost,period,deadline,offset\n2,5,5,2\n1,4,3,0\n' > "$$tmp/prefix-offset.csv"; \
	printf 'cost,period,deadline,offset\n1,1,1,0\n' > "$$tmp/tiny.csv"; \
	./scripts/periodic_edf_schedulability_csv "$$tmp/zero.csv"; \
	./scripts/periodic_edf_schedulability_csv --check-prefix-cert "$$tmp/prefix-offset.csv"; \
	./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf 30 "$$tmp/zero.csv"; \
	./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf 30 "$$tmp/nonzero.csv"; \
	./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf-cutoff "$$tmp/tiny.csv"; \
	if ./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf 30 "$$tmp/overload.csv" > "$$tmp/overload.out" 2>&1; then \
		cat "$$tmp/overload.out"; \
		exit 1; \
	fi; \
	grep -q 'window DBF overload witness t1=' "$$tmp/overload.out"; \
	if ./scripts/periodic_edf_schedulability_csv "$$tmp/offset-value.csv" > "$$tmp/offset-value-default.out" 2>&1; then \
		cat "$$tmp/offset-value-default.out"; \
		exit 1; \
	fi; \
	grep -q 'DBF overload witness t=2' "$$tmp/offset-value-default.out"; \
	./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf-cutoff "$$tmp/offset-value.csv"; \
	if ./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf -1 "$$tmp/zero.csv" > "$$tmp/bad-horizon.out" 2>&1; then \
		cat "$$tmp/bad-horizon.out"; \
		exit 1; \
	fi; \
	grep -q 'horizon H must be nonnegative' "$$tmp/bad-horizon.out"; \
	if ./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf nope "$$tmp/zero.csv" > "$$tmp/nonnumeric-horizon.out" 2>&1; then \
		cat "$$tmp/nonnumeric-horizon.out"; \
		exit 1; \
	fi; \
	grep -q 'invalid horizon H: nope' "$$tmp/nonnumeric-horizon.out"; \
	if ./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf "$$tmp/zero.csv" > "$$tmp/missing-horizon.out" 2>&1; then \
		cat "$$tmp/missing-horizon.out"; \
		exit 1; \
	fi; \
	grep -q 'usage:' "$$tmp/missing-horizon.out"; \
	if ./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf 30 > "$$tmp/missing-path.out" 2>&1; then \
		cat "$$tmp/missing-path.out"; \
		exit 1; \
	fi; \
	grep -q 'usage:' "$$tmp/missing-path.out"; \
	if ./scripts/periodic_edf_schedulability_csv --check-offset-window-dbf 30 "$$tmp/negative-offset.csv" > "$$tmp/negative-offset.out" 2>&1; then \
		cat "$$tmp/negative-offset.out"; \
		exit 1; \
	fi; \
	grep -q 'offset must be nonnegative' "$$tmp/negative-offset.out"

.PHONY: extract-periodic-edf-sched-hs build-periodic-edf-sched-csv run-periodic-edf-sched-csv sched-witness-gen test-sched-witness-gen-determinism test-periodic-edf-sched-csv
